{
    "tags": {
        "allowUnknownTags": true
    },
    "plugins": [
        "plugins/markdown",
        "../../node_modules/better-docs/typescript",
        "../../node_modules/better-docs/category"
    ],
    "recurseDepth": 10,
    "source": {
        "includePattern": "\\.(jsx|js|ts|tsx)$"
    },
    "templates": {
        "default": {
            "outputSourceFiles": true,
            "staticFiles": {
                "include": ["./jsdoc"],
                "includePattern": "/fonts/"
            }
        }
    },
    "markdown": {
        "hardwrap": true,
        "idInHeadings": true
    },
    "opts": {
        "encoding": "utf8",
        "destination": "doc/",
        "recurse": true,
        "verbose": true,
        "template": "./jsdoc",
        "tutorials": "tutorials/",
        "basePath": "/doc/",
        "siteName": "3Dmol.js",
        "footer": "3Dmol.js © 2019-2024 | <a href='https://pitt.edu/' target='_blank'>University of Pittsburgh</a> | <a href='https://github.com/3dmol/3Dmol.js/blob/master/LICENSE' target='_blank'>License</a>",
        "fonts": {
            "heading": "Work Sans",
            "body": "Open Sans",
            "mono": "Inconsolata, monospace"
        },
        "colors": {
            "bg": "#ffffff",
            "bgMuted": "#f7f7f7",
            "fg": "#111111",
            "fgMuted": "#666666",
            "accent": "#007bff",
            "accentFg": "#ffffff",
            "border": "#dddddd"
        },
        "customCssFile": "./jsdoc/classic.css",
        "menu": [
            {
                "id": "home",
                "title": "Documentation",
                "target": "_self"
            },
            {
                "title": "Tutorials",
                "link": "/doc/tutorials/home/",
                "target": "_self"
            },
            {
                "title": "GitHub",
                "link": "https://github.com/3dmol/3Dmol.js",
                "target": "_blank"
            }
        ],
        "meta": [
            {
                "name": "Author",
                "content": "David Koes & 3Dmoljs Contributors"
            },
            {
                "name": "Description",
                "content": "A modern, object-oriented JavaScript library for visualizing molecular data"
            }
        ],
        "progress": false
    }
}
